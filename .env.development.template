# Development Environment Configuration Template
# Copy this file to .env for development

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Set to true to use stub mode (no API key needed)
# OPENAI_STUB=true

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=localhost

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database Type
DB_TYPE=sqlite

# SQLite Configuration
SQLITE_PATH=./server/data/sessions.db

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

LOG_LEVEL=debug
LOG_FORMAT=pretty

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=./server/data/audit.log
AUDIT_LOG_RETENTION=30

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=100

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

REPORTS_PATH=./server/data/reports
REPORTS_MAX_SIZE=10MB
REPORTS_RETENTION=30

TEMP_PATH=./tmp
TEMP_CLEANUP=true

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

MONITORING_ENABLED=true
METRICS_PORT=9090

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# Alerting (disabled in development)
ALERTS_ENABLED=false

# =============================================================================
# DEVELOPMENT HELPERS
# =============================================================================

# Set to true for verbose debugging
# DEBUG=true

# Set to true to disable rate limiting
# DISABLE_RATE_LIMIT=true