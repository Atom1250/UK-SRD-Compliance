# Production Environment Configuration Template
# Copy this file to .env.production and fill in the values

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# OpenAI Configuration (REQUIRED unless using stub mode)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_STUB=false
# OPENAI_STRICT=true

# Server Configuration
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database Type: sqlite or postgresql
DB_TYPE=sqlite

# SQLite Configuration (if using SQLite)
SQLITE_PATH=/app/data/production.db

# PostgreSQL Configuration (if using PostgreSQL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=esg_interview_bot
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_SSL=true
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS Configuration
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
# CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

LOG_LEVEL=info
LOG_FORMAT=json
LOG_DESTINATION=stdout
LOG_MAX_FILES=5
LOG_MAX_SIZE=10m

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=/app/logs/audit.log
AUDIT_LOG_RETENTION=90

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Redis Configuration (optional)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_DB=0

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

REPORTS_PATH=/app/data/reports
REPORTS_MAX_SIZE=10MB
REPORTS_RETENTION=365

TEMP_PATH=/app/tmp
TEMP_CLEANUP=true

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

MONITORING_ENABLED=true
METRICS_PORT=9090

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_TIMEOUT=5000

# Alerting
ALERTS_ENABLED=true
# ALERT_WEBHOOK_URL=https://your-webhook-url.com/alerts
ALERT_ERROR_RATE=0.05
ALERT_RESPONSE_TIME=5000
ALERT_MEMORY_USAGE=0.85

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

BACKUP_DIR=/app/backups
BACKUP_RETENTION=30

# =============================================================================
# OPTIONAL PERFORMANCE TUNING
# =============================================================================

SERVER_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=5000
HEADERS_TIMEOUT=60000
MAX_HEADER_SIZE=16384

OPENAI_TIMEOUT=30000
OPENAI_MAX_RETRIES=3

DB_ACQUIRE_TIMEOUT=60000
DB_IDLE_TIMEOUT=30000